{
  "name": "unitconnect-cmo-analyze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "웹 기반 CSV/Excel 데이터 분석 사이트",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
