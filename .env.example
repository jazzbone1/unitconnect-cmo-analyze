# 원격(공용) 저장소 사용 설정.
# 설정하지 않으면 브라우저 localStorage에 저장됩니다.

# 원격 저장소 사용 (1 또는 true)
VITE_REMOTE_STORE=

# Cloudflare Worker 주소 (예: https://unitconnect-cmo-store.<계정>.workers.dev)
VITE_API_BASE=

# (선택) 공유 키. Worker의 AUTH_KEY와 같은 값으로 두면 아무나 접근하지 못하게 막음.
VITE_APP_KEY=

# ── AI 분석 (서버 전용, Railway Variables에 설정) ──
# Claude API 키. 설정하면 사업성 총평·보고서 초안 AI 생성 버튼이 활성화됩니다.
# 키는 서버(server.mjs)에서만 사용되며 브라우저에 노출되지 않습니다.
ANTHROPIC_API_KEY=
# (선택) 모델 ID. 기본 claude-opus-5. 저비용은 claude-haiku-4-5.
ANTHROPIC_MODEL=

# ── SSO (메신저 ERP 자동로그인, 서버 전용) ──
# 메신저(dealerconnect/ERP)와 공유하는 서명 시크릿(HS256). 양쪽에 동일 값 설정.
# 설정 시 ?sso=<JWT> 로 진입하면 자동로그인되고, 세션 없으면 접근 차단됩니다.
# 비우면 SSO 비활성(로그인 없이 동작).
SSO_SECRET=
